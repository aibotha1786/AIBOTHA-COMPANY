    <script>
        // Simulate startup sequence
        setTimeout(() => {
            let progress = 0;
            const interval = setInterval(() => {
                progress += Math.random() * 10;
                if (progress >= 100) {
                    clearInterval(interval);
                    document.getElementById('loading-bar').style.width = '100%';
                    setTimeout(() => {
                        document.getElementById('startup-screen').classList.add('hidden');
                        document.getElementById('lock-screen').classList.remove('hidden');
                        updateDateTime();
                    }, 500);
                } else {
                    document.getElementById('loading-bar').style.width = `${progress}%`;
                }
            }, 200);
        }, 1000);

        // Update date and time
        function updateDateTime() {
            const now = new Date();
            const timeStr = now.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
            const dateStr = now.toLocaleDateString([], { weekday: 'long', month: 'long', day: 'numeric' });
            
            document.getElementById('lock-time').textContent = timeStr;
            document.getElementById('lock-date').textContent = dateStr;
            document.getElementById('current-time').textContent = timeStr;
        }

        setInterval(updateDateTime, 1000);

        // Handle lock screen swipe
        let startY = 0;
        const lockScreen = document.getElementById('lock-screen');
        
        lockScreen.addEventListener('touchstart', (e) => {
            startY = e.touches[0].clientY;
        }, false);
        
        lockScreen.addEventListener('touchmove', (e) => {
            const y = e.touches[0].clientY;
            if (startY - y > 50) { // Swipe up
                unlockDevice();
            }
        }, false);
        
        lockScreen.addEventListener('touchend', () => {
            startY = 0;
        }, false);

        function unlockDevice() {
            lockScreen.classList.add('hidden');
            document.getElementById('home-screen').classList.remove('hidden');
        }

        // Show notification panel
        function showNotificationPanel() {
            document.getElementById('notification-panel').classList.add('open');
        }

        function hideNotificationPanel() {
            document.getElementById('notification-panel').classList.remove('open');
        }

        // Show control center
        function showControlCenter() {
            document.getElementById('control-center').classList.add('open');
        }

        function hideControlCenter() {
            document.getElementById('control-center').classList.remove('open');
        }

        // App switcher
        function showAppSwitcher() {
            document.getElementById('app-switcher').classList.remove('hidden');
        }

        function hideAppSwitcher() {
            document.getElementById('app-switcher').classList.add('hidden');
        }

        // App management
        function openApp(appId) {
            document.getElementById('home-screen').classList.add('hidden');
            document.getElementById(appId).classList.remove('hidden');
        }

        function closeApp(appId) {
            document.getElementById(appId).classList.add('hidden');
            document.getElementById('home-screen').classList.remove('hidden');
        }

        function showHome() {
            // Close all apps
            document.querySelectorAll('[id$="-app"]').forEach(el => {
                el.classList.add('hidden');
            });
            document.getElementById('home-screen').classList.remove('hidden');
        }

        // Terminal input handler
        function handleTerminalInput(e) {
            if (e.key === 'Enter') {
                const input = document.getElementById('terminal-input');
                const command = input.value.trim();
                input.value = '';
                
                const output = document.getElementById('terminal-output');
                
                // Add user command to output
                const userCommand = document.createElement('div');
                userCommand.className = 'flex mb-2';
                userCommand.innerHTML = `
                    <span class="text-blue-400 mr-2">user@ai-os:~$</span>
                    <span>${command}</span>
                `;
                output.appendChild(userCommand);
                
                // Process command
                let response = '';
                switch (command.toLowerCase()) {
                    case 'help':
                        response = `
                            <div>Available commands:</div>
                            <div class="ml-4">
                                <div>- help: Show this help message</div>
                                <div>- apps: List available applications</div>
                                <div>- open [app]: Launch an application</div>
                                <div>- search [query]: Web search</div>
                                <div>- clear: Clear terminal</div>
                                <div>- theme [light/dark]: Change UI theme</div>
                            </div>
                        `;
                        break;
                    case 'apps':
                        response = `
                            <div>Available applications:</div>
                            <div class="ml-4">
                                <div>- terminal</div>
                                <div>- files</div>
                                <div>- browser</div>
                                <div>- settings</div>
                                <div>- assistant</div>
                                <div>- appstore</div>
                            </div>
                        `;
                        break;
                    case 'clear':
                        output.innerHTML = `
                            <div class="mb-4">
                                <div class="text-green-400 mb-1">AI BOTHA v3.2.1</div>
                                <div class="text-gray-400 text-sm">Type "help" for available commands</div>
                            </div>
                        `;
                        return;
                    case 'theme dark':
                        document.body.classList.remove('light-theme');
                        document.body.classList.add('dark-theme');
                        response = 'Switched to dark theme';
                        break;
                    case 'theme light':
                        document.body.classList.remove('dark-theme');
                        document.body.classList.add('light-theme');
                        response = 'Switched to light theme';
                        break;
                    case 'open terminal':
                        closeApp('ai-terminal');
                        openApp('ai-terminal');
                        return;
                    case 'open settings':
                        closeApp('ai-terminal');
                        openApp('settings');
                        return;
                    case 'open assistant':
                        closeApp('ai-terminal');
                        openApp('assistant');
                        return;
                    case 'open appstore':
                        closeApp('ai-terminal');
                        openApp('app-store');
                        return;
                    default:
                        if (command.startsWith('open ')) {
                            response = `Unknown application: ${command.substring(5)}`;
                        } else if (command.startsWith('search ')) {
                            response = `Searching the web for: ${command.substring(7)}`;
                        } else {
                            response = `Command not found: ${command}. Type "help" for available commands.`;
                        }
                }
                
                const commandResponse = document.createElement('div');
                commandResponse.className = 'text-gray-300 mb-4';
                commandResponse.innerHTML = response;
                output.appendChild(commandResponse);
                
                // Scroll to bottom
                output.scrollTop = output.scrollHeight;
            }
        }

        // Assistant input handler
        function handleAssistantInput(e) {
            if (e.key === 'Enter') {
                const input = document.getElementById('assistant-input');
                const message = input.value.trim();
                input.value = '';
                
                const chat = document.getElementById('assistant-chat');
                
                // Add user message
                const userMessage = document.createElement('div');
                userMessage.className = 'flex mb-4 justify-end';
                userMessage.innerHTML = `
                    <div class="bg-blue-500 rounded-2xl p-3 max-w-xs">
                        <p>${message}</p>
                    </div>
                `;
                chat.appendChild(userMessage);
                
                // Process message
                let response = '';
                if (message.toLowerCase().includes('hello') || message.toLowerCase().includes('hi')) {
                    response = 'Hello there! How can I assist you today?';
                } else if (message.toLowerCase().includes('time')) {
                    const now = new Date();
                    response = `The current time is ${now.toLocaleTimeString()}.`;
                } else if (message.toLowerCase().includes('date')) {
                    const now = new Date();
                    response = `Today is ${now.toLocaleDateString()}.`;
                } else if (message.toLowerCase().includes('open') && message.toLowerCase().includes('app')) {
                    const appMatch = message.match(/open (.*)/i);
                    if (appMatch) {
                        const appName = appMatch[1].toLowerCase();
                        if (appName.includes('terminal')) {
                            closeApp('assistant');
                            openApp('ai-terminal');
                            return;
                        } else if (appName.includes('settings')) {
                            closeApp('assistant');
                            openApp('settings');
                            return;
                        } else if (appName.includes('store')) {
                            closeApp('assistant');
                            openApp('app-store');
                            return;
                        } else {
                            response = `I can't find the app "${appName}". Try being more specific.`;
                        }
                    } else {
                        response = 'Which app would you like me to open?';
                    }
                } else {
                    response = 'I understand you asked about "' + message + '". As an AI assistant, I can help with opening apps, answering questions, and more.';
                }
                
                // Add assistant response
                setTimeout(() => {
                    const assistantResponse = document.createElement('div');
                    assistantResponse.className = 'flex mb-4';
                    assistantResponse.innerHTML = `
                        <div class="w-10 h-10 rounded-full bg-gradient-to-br from-purple-500 to-indigo-600 flex items-center justify-center mr-3">
                            <i class="fas fa-robot text-white"></i>
                        </div>
                        <div class="bg-gray-800 rounded-2xl p-3 max-w-xs">
                            <p>${response}</p>
                        </div>
                    `;
                    chat.appendChild(assistantResponse);
                    
                    // Scroll to bottom
                    chat.scrollTop = chat.scrollHeight;
                }, 500);
            }
        }

        // Swipe down for notifications
        let touchStartY = 0;
        const homeScreen = document.getElementById('home-screen');
        
        homeScreen.addEventListener('touchstart', (e) => {
            touchStartY = e.touches[0].clientY;
        }, false);
        
        homeScreen.addEventListener('touchmove', (e) => {
            const y = e.touches[0].clientY;
            if (y - touchStartY > 50 && window.scrollY <= 0) { // Swipe down
                showNotificationPanel();
            }
        }, false);
        
        homeScreen.addEventListener('touchend', () => {
            touchStartY = 0;
        }, false);

        // Swipe up for control center
        homeScreen.addEventListener('touchstart', (e) => {
            touchStartY = e.touches[0].clientY;
        }, false);
        
        homeScreen.addEventListener('touchmove', (e) => {
            const y = e.touches[0].clientY;
            if (touchStartY - y > 50 && window.scrollY >= document.body.scrollHeight - window.innerHeight) { // Swipe up
                showControlCenter();
            }
        }, false);
    </script>
</body>
</html>